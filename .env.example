# AI PR Reviewer - Environment Configuration

# Server
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# GitHub App & Webhook Security
# Replace this example before production; production startup rejects it.
GITHUB_WEBHOOK_SECRET=replace_with_strong_random_secret_string_e92bf18a
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM Engine Configuration
# Providers: heuristic-engine (built-in offline zero-cost), gemini, openai, anthropic, ollama
LLM_PROVIDER=heuristic-engine
LLM_MODEL=gpt-4o
LLM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Data Privacy & Security Guard
# Auto-redacts AWS keys, Stripe secrets, GitHub tokens, DB passwords, and PII before LLM dispatch
STRICT_PRIVACY_MODE=true

# Review Caps & Token Bounds
MAX_COMMENTS_PER_PR=20
MAX_DIFF_TOKENS=60000

# Frontend URL
VITE_API_URL=http://localhost:5000
